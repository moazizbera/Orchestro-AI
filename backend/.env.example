# ─────────────────────────────────────────────────────────────────────────────
# Orchestro AI — Environment Configuration
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# ══ Phase 1: Gemini Enterprise Agent Platform ════════════════════════════════
#
# Option A — Gemini Developer API (local / hackathon demo)
#   Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Option B — Vertex AI (production / Cloud Run)
#   Set GEMINI_BACKEND=vertex and supply your GCP project.
#   Authentication uses Application Default Credentials (ADC):
#     gcloud auth application-default login
#   OR set GOOGLE_APPLICATION_CREDENTIALS to a service-account key file path.
GEMINI_BACKEND=developer
# GEMINI_BACKEND=vertex
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=

# Gemini model to use (both developer and vertex backends)
GEMINI_MODEL=gemini-2.0-flash


# ══ Phase 3: MongoDB Partner Integration ════════════════════════════════════
#
# Local development (mirrors Atlas locally via Docker Compose)
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=orchestro_ai
# Official MongoDB MCP server bridge used by the backend.
# Requires Node.js 22.22.2+ for the cleanest local experience.
MONGODB_MCP_ENABLED=true
MONGODB_MCP_COMMAND=npx -y mongodb-mcp-server@latest
MONGODB_MCP_READ_ONLY=false
MONGODB_MCP_DISABLED_TOOLS=
#
# MongoDB Atlas (production)
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# DATABASE_NAME=orchestro_ai


# ══ Phase 4: Secret Manager ══════════════════════════════════════════════════
#
# When GOOGLE_CLOUD_PROJECT is set, the backend automatically loads secrets
# from GCP Secret Manager at startup (see services/secret_manager.py).
# Secrets are expected under these IDs (latest version):
#   orchestro-gemini-api-key
#   orchestro-mongodb-uri
#   orchestro-ollama-api-key
#   orchestro-resend-api-key
# Any secret already present in the environment is NOT overwritten.


# ══ Phase 3: Arize Phoenix observability ════════════════════════════════════
#
# Option A — Local Phoenix (free, self-hosted):
#   pip install arize-phoenix opentelemetry-sdk openinference-instrumentation-google-genai
#   phoenix serve   → http://localhost:6006
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
OTEL_SERVICE_NAME=orchestro-ai
#
# Option B — Arize SaaS:
ARIZE_API_KEY=
ARIZE_SPACE_KEY=


# ══ Phase 5: Cloud Run deployment ═══════════════════════════════════════════
#
# Build and deploy the backend container:
#   gcloud run deploy orchestro-ai \
#     --source ./backend \
#     --region us-central1 \
#     --allow-unauthenticated \
#     --set-env-vars GOOGLE_CLOUD_PROJECT=<your-project>,GEMINI_BACKEND=vertex,MONGODB_MCP_ENABLED=true


# ══ Optional: Ollama (self-hosted LLM) ══════════════════════════════════════
OLLAMA_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
PREFERRED_PROVIDER=gemini
AI_REQUEST_TIMEOUT_SECONDS=25
AI_MAX_OUTPUT_TOKENS=900
AI_RETRY_ATTEMPTS=1
AI_MODE=auto


# ══ Email (Resend) ═══════════════════════════════════════════════════════════
# https://resend.com/api-keys
RESEND_API_KEY=
RESEND_TEST_EMAIL=

